### IntelliJ IDEA ###
.idea
*.iws
*.iml
*.ipr
out/

# OS
.DS_Store
*.pem

### Frontend (Next.js) ###
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

.next/
coverage/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (운영용 실제 파일은 추적 X, 템플릿은 추적)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

### Backend (Gradle / Spring Boot) ###
.gradle/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# 운영용 외부 설정 (실제 파일은 추적 X, 템플릿/디렉토리는 추적)
backend/config/application.yml
backend/config/application-*.yml
!backend/config/*.example
!backend/config/.gitkeep
